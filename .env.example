# Circum — Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# Generate secrets with: openssl rand -base64 32

# Database (SQLite for development; PostgreSQL for production — see ADR-0002)
DATABASE_URL=file:./db/custom.db

# NextAuth (authentication)
NEXTAUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=http://localhost:3000

# Password hashing pepper (argon2id + pepper). Changing invalidates all existing password hashes.
AUTH_PEPPER=CHANGE_ME

# Integration credential encryption key (AES-256-GCM, base64-encoded 32 bytes).
# Changing invalidates all existing encrypted integration credentials.
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME

# Optional: seed demo password (defaults to CircumDemo2025! if not set)
# SEED_DEMO_PASSWORD=CircumDemo2025!

# Optional: AI provider (defaults to "zai")
# AI_PROVIDER=zai

# Optional: log level (defaults to "info")
# LOG_LEVEL=info
