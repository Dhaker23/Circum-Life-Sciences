# See https://help.github.com/articles/ignoring-files/ for more about about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets. Use .env.example for the template.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local development artifacts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log
prompt

# database files (SQLite local dev/test databases — never commit)
db/custom.db
db/test.db
db/*.db-wal
db/*.db-shm
db/*.db-journal

# backup artifacts
backups/
backups-test/

# tool/agent temporary output
tool-results/
agent-ctx/

# sandbox-specific artifacts (not needed for GitHub/Vercel/local)
.zscripts/
Caddyfile
download/

# skills directory (Z.ai platform skills — not Circum application code)
/skills/
